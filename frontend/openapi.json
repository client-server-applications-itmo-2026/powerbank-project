{"openapi": "3.1.0", "info": {"title": "Powerbank API", "version": "1.0.0", "description": "API for Powerbank project"}, "paths": {"/api/me": {"get": {"operationId": "server_apps_users_api_get_me", "summary": "Get Me", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserRetrieveResponse"}}}}}, "security": [{"BasicAuth": []}]}, "patch": {"operationId": "server_apps_users_api_update_me", "summary": "Update Me", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserRetrieveResponse"}}}}}, "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateAuthenticatedUserRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/register": {"post": {"operationId": "server_apps_users_api_register_user", "summary": "Register User", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserRetrieveResponse"}}}}}, "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterUserRequest"}}}, "required": true}}}, "/api/pull-stantion-task": {"post": {"operationId": "server_apps_stantions_api_pull_stantion_task", "summary": "Pull Stantion Task", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StantionTaskInfo"}}}}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447 \u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439. \u0421\u0442\u0430\u043d\u0446\u0438\u044f \u0448\u043b\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441, \u0430 \u043c\u044b \u0435\u0439 \u0432 \u043e\u0442\u0432\u0435\u0442\n\u043e\u0442\u0434\u0430\u0435\u043c \u0437\u0430\u0434\u0430\u0447\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c.", "tags": ["tasks"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PullStantionTaskRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/accept-stantion-task": {"post": {"operationId": "server_apps_stantions_api_accept_stantion_task", "summary": "Accept Stantion Task", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StantionTaskInfo"}}}}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439. \u0421\u0442\u0430\u043d\u0446\u0438\u044f \u0448\u043b\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u0441 id \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e\n\u043e\u043d\u0430 \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u0432 \u0440\u0430\u0431\u043e\u0442\u0443, \u0430 \u043c\u044b \u043c\u0435\u043d\u044f\u0435\u043c \u0441\u0442\u0430\u0442\u0443\u0441 \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0430 \"\u043f\u0440\u0438\u043d\u044f\u0442\u0430\". \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0430\n\u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u0438\u043b\u0438 \u0443\u0436\u0435 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u043d\u044f\u0442\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439, \u0442\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043c \u043e\u0448\u0438\u0431\u043a\u0443.", "tags": ["tasks"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AcceptStantionTaskRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/create-stantion-task-result": {"post": {"operationId": "server_apps_stantions_api_create_stantion_task_result", "summary": "Create Stantion Task Result", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StantionTaskInfo"}}}}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439. \u0421\u0442\u0430\u043d\u0446\u0438\u044f \u0448\u043b\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441\n\u0441 id \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b\u0430, \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f (\u0443\u0441\u043f\u0435\u0445 \u0438\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0430),\n\u0430 \u043c\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u044d\u0442\u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432 \u0431\u0430\u0437\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043c\u0435\u043d\u044f\u0435\u043c \u0441\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u0434\u0430\u0447\u0438 \u043d\u0430\n\"\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430\". \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0430 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u0438\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b\u0430 \u043f\u0440\u0438\u043d\u044f\u0442\u0430 \u044d\u0442\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439, \u0442\u043e\n\u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043c \u043e\u0448\u0438\u0431\u043a\u0443.", "tags": ["tasks"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateStantionTaskResultRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/create-stantion-heartbeat": {"post": {"operationId": "server_apps_stantions_api_create_stantion_heartbeat", "summary": "Create Stantion Heartbeat", "parameters": [], "responses": {"204": {"description": "No Content"}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f heartbeat \u043e\u0442 \u0441\u0442\u0430\u043d\u0446\u0438\u0438. \u0421\u0442\u0430\u043d\u0446\u0438\u044f \u0448\u043b\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u0441\n\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439 \u043e \u0441\u0435\u0431\u0435 (id, \u043c\u043e\u0434\u0435\u043b\u044c, \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435) \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u0441\u0432\u043e\u0438\u0445 \u0441\u043b\u043e\u0442\u043e\u0432\n(\u043a\u0430\u043a\u0438\u0435 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043a\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u043d\u0438\u0445 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f). \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u043c\u044b \u0441\u043e\u0437\u0434\u0430\u0435\u043c\n\u0438\u043b\u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u043c \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u0432 \u0431\u0430\u0437\u0435 \u0434\u0430\u043d\u043d\u044b\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u0435\u043c \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u043d\u043e\u0432\u043e\u043c\nheartbeat \u043e\u0442 \u044d\u0442\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0438. \u0422\u0430\u043a\u0436\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e \u0441\u043b\u043e\u0442\u0430\u0445 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043c\u044b\n\u043c\u043e\u0436\u0435\u043c \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438 \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0441\u043b\u0438 \u043c\u044b \u0432\u0438\u0434\u0438\u043c, \u0447\u0442\u043e \u0432 \u043e\u0434\u043d\u043e\u043c\n\u0438\u0437 \u0441\u043b\u043e\u0442\u043e\u0432 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0430\u0441\u044c \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043a\u0430, \u0442\u043e \u043c\u043e\u0436\u0435\u043c \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u0432\u044b\u0434\u0430\u0447\u0443 \u043d\u043e\u0432\u043e\u0439\n\u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043a\u0438 \u0432 \u044d\u0442\u043e\u0442 \u0441\u043b\u043e\u0442).", "tags": ["stantions-lifecycle"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateStantionHeartBeatRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/register-stantion": {"post": {"operationId": "server_apps_stantions_api_register_stantion", "summary": "Register Stantion", "parameters": [], "responses": {"204": {"description": "No Content"}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u043e\u0432\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0438. \u0421\u0442\u0430\u043d\u0446\u0438\u044f \u0448\u043b\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u0441 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439 \u043e \u0441\u0435\u0431\u0435\n(id, \u043c\u043e\u0434\u0435\u043b\u044c, \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435), \u0430 \u043c\u044b \u0441\u043e\u0437\u0434\u0430\u0435\u043c \u0437\u0430\u043f\u0438\u0441\u044c \u043e \u043d\u0435\u0439 \u0432 \u0431\u0430\u0437\u0435 \u0434\u0430\u043d\u043d\u044b\u0445. \u0415\u0441\u043b\u0438\n\u0441\u0442\u0430\u043d\u0446\u0438\u044f \u0441 \u0442\u0430\u043a\u0438\u043c id \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u0442\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043c \u043e\u0448\u0438\u0431\u043a\u0443.", "tags": ["stantions-lifecycle"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterStantionRequest"}}}, "required": true}, "security": [{"BasicAuth": []}]}}, "/api/stantions": {"get": {"operationId": "server_apps_stantions_api_retrieve_stantions", "summary": "Retrieve Stantions", "parameters": [{"in": "query", "name": "lat", "schema": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Lat"}, "required": false}, {"in": "query", "name": "lon", "schema": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Lon"}, "required": false}, {"in": "query", "name": "radius_meters", "schema": {"default": 2000, "title": "Radius Meters", "type": "integer"}, "required": false}, {"in": "query", "name": "limit", "schema": {"default": 100, "title": "Limit", "type": "integer"}, "required": false}, {"in": "query", "name": "offset", "schema": {"default": 0, "title": "Offset", "type": "integer"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RetrieveNearestStantionsResponse"}}}}}, "description": "\u041c\u0435\u0442\u043e\u0434 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u043f\u0438\u0441\u043a\u0430 \u0441\u0442\u0430\u043d\u0446\u0438\u0439, \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 