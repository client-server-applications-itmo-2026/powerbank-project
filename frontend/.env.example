# Пример настройки для локальной разработки.
# Скопируй этот файл в .env и подставь нужные значения.

# Вариант 1: использовать прокси Vite (рекомендуется для разработки).
#   Укажи VITE_API_TARGET — куда Vite будет проксировать запросы с /api.
#   VITE_API_BASE_URL — оставь пустым.
VITE_API_TARGET=http://localhost:8000
VITE_API_BASE_URL=

# Вариант 2: обращаться к бекенду напрямую (нужен CORS на сервере).
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_TARGET — не используется.
